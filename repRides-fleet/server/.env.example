# Copy this file to .env and fill in the values. .env is gitignored.

# Required: the owner password for /login.
# Pick something strong — there is only ever one of these.
OWNER_PASSWORD=

# Optional: where the SQLite file lives. Defaults to ./data/fleet.db
# DATABASE_PATH=

# Optional: server port. Defaults to 3001.
# PORT=

# Optional: comma-separated allowed origins for CORS. e.g. https://yoursite.netlify.app
# ALLOWED_ORIGIN=

# Optional: the public site URL, used in SMS links. e.g. https://reputablerides.netlify.app
# SITE_URL=

# Twilio SMS notifications to the owner on each new rental request.
# All four are required to enable SMS — leave blank to disable.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=   # the Twilio-issued number, e.g. +15551234567
# OWNER_PHONE=          # where to send the alerts, e.g. +15559876543
